{
  "name": "SDSAP Pickleball",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "SDSAP Preview",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "npm ci",
  "postStartCommand": "nohup npm run dev > /tmp/sdsap-vite.log 2>&1 &"
}
