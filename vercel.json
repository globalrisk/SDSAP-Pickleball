{
  "functions": {
    "api/duel-solve.py": {
      "maxDuration": 300,
      "excludeFiles": "{node_modules/**,dist/**,artifacts.local/**,src/**,supabase/**,docs/**,scripts/**,.git/**}"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/.*", "status": 404 },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
